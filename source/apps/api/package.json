  },
  "devDependencies": {
    "@nestjs/cli": "12.0.7",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.0.0",
    "eslint": "^9.0.0",
    "prisma": "^7.10.0",
    "tsx": "^4.0.0",
